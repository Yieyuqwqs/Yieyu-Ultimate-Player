{
  "name": "yieyu-ts-clean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "模块6：JSON 解析与数据清洗（Zod / Axios）",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --outDir ../out/ts/esm && esbuild ../out/ts/esm/clean/index.js --bundle --format=esm --minify --outfile=../out/ts/cleaner.mjs",
    "test": "node --experimental-strip-types --test src/**/*.test.ts || true"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
